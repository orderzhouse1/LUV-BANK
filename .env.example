# Shared / runtime
NODE_ENV=development

# Persistence: memory (dev/tests only; resets on API restart) | prisma (requires migrated Neon URLs)
# Production must use prisma — memory is rejected at startup validation.
# Phase 10 Neon validation requires PERSISTENCE_DRIVER=prisma on a dedicated non-production branch.
PERSISTENCE_DRIVER=memory

# Neon PostgreSQL (Prisma)
# DATABASE_URL: pooled runtime connection (often includes -pooler host) — required for API prisma mode
# DIRECT_URL: direct/non-pooled connection for migrations only (migration job / prisma migrate)
# Replace placeholders with a dedicated Neon development/QA/staging branch — never production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Reviewed scoring policy only (unknown values fail startup validation once enforced)
ACTIVE_SCORING_POLICY=MVP_EQUAL_WEIGHT_V1

# API (apps/api)
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Cookie placeholders (host-only locally: leave COOKIE_DOMAIN empty)
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Auth secrets — use long unique values; never reuse access, refresh, and CSRF secrets
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_ACCESS_SECRET_AT_LEAST_32
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_REFRESH_SECRET_32
JWT_ISSUER=luv-bank-api
JWT_AUDIENCE=luv-bank-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CSRF_SECRET=REPLACE_WITH_A_LONG_RANDOM_CSRF_SECRET_AT_LEAST_32

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=300
REQUEST_BODY_LIMIT=100kb
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=25000

# Express trust proxy hop count. Use 1 behind a single reverse proxy. Never set unconditional true.
TRUST_PROXY_HOPS=0

# Local container smoke only (localhost/127.0.0.1). Never enable in real production.
ALLOW_INSECURE_LOCAL_PRODUCTION_SMOKE=false

# Reviewed descriptive insight ruleset only (unknown values fail startup validation)
ACTIVE_INSIGHT_RULESET=DESCRIPTIVE_INSIGHTS_V1

# Reviewed gentle nudge ruleset only (unknown values fail startup validation)
ACTIVE_NUDGE_RULESET=GENTLE_NUDGES_V1

# Reviewed private share snapshot version only (unknown values fail startup validation)
ACTIVE_SHARE_SNAPSHOT_VERSION=PRIVATE_SHARE_SNAPSHOT_V1

# Web (apps/web) — NEXT_PUBLIC_* values are public and may be compiled into the browser bundle
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# PWA (Phase 9) — service worker registers in production builds by default.
# Set NEXT_PUBLIC_PWA_ENABLE=true only when intentionally testing SW locally.
# NEXT_PUBLIC_PWA_ENABLE=false
PWA_CACHE_VERSION=phase-9-v1
