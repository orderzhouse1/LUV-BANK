# Operator template — substitute via secret manager. No real credentials.
NODE_ENV=production
PERSISTENCE_DRIVER=prisma

API_PUBLIC_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com
COOKIE_DOMAIN=.example.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=1

DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require

JWT_ACCESS_SECRET=REPLACE_WITH_UNIQUE_ACCESS_SECRET_MIN_32
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_REFRESH_SECRET_32
CSRF_SECRET=REPLACE_WITH_UNIQUE_CSRF_SECRET_MIN_32_CHARS
JWT_ISSUER=luv-bank-api
JWT_AUDIENCE=luv-bank-web

ACTIVE_SCORING_POLICY=MVP_EQUAL_WEIGHT_V1
ACTIVE_INSIGHT_RULESET=DESCRIPTIVE_INSIGHTS_V1
ACTIVE_NUDGE_RULESET=GENTLE_NUDGES_V1
ACTIVE_SHARE_SNAPSHOT_VERSION=PRIVATE_SHARE_SNAPSHOT_V1

NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_DEFAULT_LOCALE=en
PWA_CACHE_VERSION=phase-9-v1

# Never set ALLOW_INSECURE_LOCAL_PRODUCTION_SMOKE in real production.
