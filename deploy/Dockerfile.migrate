# One-shot migration image. Never used as the long-running API process.
# docker build -f deploy/Dockerfile.migrate -t luv-bank-migrate:phase11 .

ARG NODE_VERSION=22.17.0

FROM node:${NODE_VERSION}-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.30.3 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc* ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/config/package.json packages/config/
COPY packages/database/package.json packages/database/
COPY packages/validation/package.json packages/validation/
RUN pnpm install --frozen-lockfile

FROM deps AS runtime
COPY packages/database packages/database
COPY packages/config packages/config
COPY tsconfig.base.json ./
ENV DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build?sslmode=require"
ENV DIRECT_URL="postgresql://build:build@127.0.0.1:5432/build?sslmode=require"
RUN pnpm --filter @luv-bank/database exec prisma generate --schema prisma/schema.prisma

RUN groupadd --system --gid 10001 luvbank \
 && useradd --system --uid 10001 --gid luvbank --create-home luvbank
USER luvbank
WORKDIR /app/packages/database

# Operator must supply DIRECT_URL (and usually DATABASE_URL) at runtime.
# No automatic migrate on image start — compose overrides command explicitly.
ENTRYPOINT ["pnpm", "exec", "prisma"]
CMD ["migrate", "status", "--schema", "prisma/schema.prisma"]
