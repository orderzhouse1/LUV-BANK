# Local Phase 11 container smoke secrets — never commit a filled copy.
# Use only the dedicated non-production Neon branch (br-gentle-sea-*).

NODE_ENV=production
PERSISTENCE_DRIVER=prisma

# Pooled runtime URL for the API container
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Direct URL for the explicit migrate profile only
DIRECT_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

API_PUBLIC_URL=http://127.0.0.1:4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=0
ALLOW_INSECURE_LOCAL_PRODUCTION_SMOKE=true

JWT_ACCESS_SECRET=local-smoke-access-secret-at-least-32ch
JWT_REFRESH_SECRET=local-smoke-refresh-secret-at-least-32
CSRF_SECRET=local-smoke-csrf-secret-at-least-32chars
JWT_ISSUER=luv-bank-api
JWT_AUDIENCE=luv-bank-web

ACTIVE_SCORING_POLICY=MVP_EQUAL_WEIGHT_V1
ACTIVE_INSIGHT_RULESET=DESCRIPTIVE_INSIGHTS_V1
ACTIVE_NUDGE_RULESET=GENTLE_NUDGES_V1
ACTIVE_SHARE_SNAPSHOT_VERSION=PRIVATE_SHARE_SNAPSHOT_V1

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_DEFAULT_LOCALE=en
PWA_CACHE_VERSION=phase-9-v1
